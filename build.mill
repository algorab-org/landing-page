//| mill-version: 1.1.6
//| mvnDeps:
//| - com.lihaoyi::mill-contrib-artifactory:$MILL_VERSION
//| - io.github.iltotore::mill-tailwind::0.1.1

package build

import mill.*, scalalib.*, scalafmt.*, publish.*
import mill.contrib.artifactory.ArtifactoryPublishModule

import mill.util.VcsVersion
import io.github.iltotore.tailwind.TailwindModule

object `package` extends ScalaModule, ScalafmtModule, TailwindModule, DotEnvModule, ArtifactoryPublishModule:

  def scalaVersion = "3.5.1"
  def tailwindVersion = "4.1.8"

  def artifactName = "landing-page"

  def publishVersion = Task(VcsVersion.vcsState().format(untaggedSuffix = "-SNAPSHOT"))

  def pomSettings =
    PomSettings(
      description = "Algorab's landing page",
      organization = "org.algorab",
      url = "https://github.com/algorab-org/landing-page",
      licenses = Seq(License.`Apache-2.0`),
      versionControl = VersionControl.github("algorab-org", "landing-page"),
      developers = Seq(
        Developer("Algorab", "Algorab Team", "https://github.com/algorab-org")
      )
    )

  def extraPublish = Task(
    Seq(PublishInfo(assembly(), classifier = Some("assembly"), ivyConfig = "compile"))
  )

  def artifactoryUri = "https://maven.pkg.github.com/algorab-org/landing-page"
  def artifactorySnapshotUri = "https://maven.pkg.github.com/algorab-org/landing-page"

  def mvnDeps = Seq(
    mvn"com.github.daddykotex::courier:4.0.0-RC1",
    mvn"com.lihaoyi::cask:0.9.2",
    mvn"com.lihaoyi::os-lib:0.11.3",
    mvn"com.lihaoyi::scalatags:0.13.1",
    mvn"com.lihaoyi::scalasql:0.1.11",
    mvn"dev.zio::zio-parser:0.1.11",
    mvn"io.github.iltotore::iron:2.6.0",
    mvn"org.postgresql:postgresql:42.7.4"
  )
